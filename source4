local frames = 0
local lastTime = tick()

RunService.RenderStepped:Connect(function()
    frames = frames + 1

    local now = tick()

    if now - lastTime >= 0.5 then
        local fps = math.floor(
            frames / (now - lastTime)
        )

        FPSLabel.Text = tostring(fps) .. " FPS"

        frames = 0
        lastTime = now
    end
end)

