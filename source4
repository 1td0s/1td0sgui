function tdos:SetBackground(color)
    Theme.Background = color

    Window.BackgroundColor3 = color
    TopBar.BackgroundColor3 = color
    Footer.BackgroundColor3 = color
end

function tdos:SetAccent(color)
    Theme.Accent = color

    FPSLabel.TextColor3 = color
end

function tdos:SetTitle(title)
    FooterTitle.Text = tostring(title)
end

function tdos:GetUsername()
    return LocalPlayer.DisplayName
end

function tdos:GetFPS()
    return tonumber(
        string.match(FPSLabel.Text, "%d+")
    ) or 0
end

function tdos:Destroy()
    if ScreenGui then
        ScreenGui:Destroy()
    end
end

