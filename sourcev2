        function Tab:CreateSlider(options)

            options = options or {}

            local Minimum = tonumber(options.Min) or 0
            local Maximum = tonumber(options.Max) or 100
            local Value = tonumber(options.Default) or Minimum

            if Maximum <= Minimum then
                Maximum = Minimum + 1
            end

            Value = math.clamp(
                Value,
                Minimum,
                Maximum
            )

            local Holder = New("Frame", {

                Size = UDim2.new(1, 0, 0, 65),

                BackgroundColor3 = Theme.Panel

            }, TabPage)

            Corner(Holder, 8)

            New("TextLabel", {

                Size = UDim2.new(0.7, 0, 0, 25),

                Position = UDim2.new(0, 14, 0, 6),

                BackgroundTransparency = 1,

                Text = options.Name or "Slider",

                TextColor3 = Theme.Text,

                TextSize = 14,

                Font = Enum.Font.Gotham,

                TextXAlignment = Enum.TextXAlignment.Left

            }, Holder)

            local ValueLabel = New("TextLabel", {

                Size = UDim2.new(0.25, 0, 0, 25),

                Position = UDim2.new(0.72, 0, 0, 6),

                BackgroundTransparency = 1,

                Text = tostring(Value),

                TextColor3 = Theme.Accent,

                TextSize = 13,

                Font = Enum.Font.GothamSemibold,

                TextXAlignment = Enum.TextXAlignment.Right

            }, Holder)

            local Bar = New("Frame", {

                Size = UDim2.new(1, -28, 0, 7),

                Position = UDim2.new(0, 14, 0, 44),

                BackgroundColor3 = Color3.fromRGB(24, 34, 55)

            }, Holder)

            Corner(Bar, 5)

            local Fill = New("Frame", {

                Size = UDim2.new(
                    (Value - Minimum) / (Maximum - Minimum),
                    0,
                    1,
                    0
                ),

                BackgroundColor3 = Theme.Accent

            }, Bar)

            Corner(Fill, 5)

            local SliderObject = {}

            local Dragging = false

            local function Set(value)

                Value = math.clamp(
                    tonumber(value) or Minimum,
                    Minimum,
                    Maximum
                )

                local Percent =
                    (Value - Minimum) /
                    (Maximum - Minimum)

                Fill.Size = UDim2.new(
                    Percent,
                    0,
                    1,
                    0
                )

                ValueLabel.Text =
                    tostring(math.floor(Value * 100) / 100)

                if typeof(options.Callback) == "function" then
                    task.spawn(options.Callback, Value)
                end

            end

            local function SetFromMouse(x)

                local Percent = math.clamp(

                    (x - Bar.AbsolutePosition.X) /
                    Bar.AbsoluteSize.X,

                    0,
                    1

                )

                Set(
                    Minimum +
                    (Maximum - Minimum) *
                    Percent
                )

            end

            Bar.InputBegan:Connect(function(input)

                if input.UserInputType ==
                    Enum.UserInputType.MouseButton1 then

                    Dragging = true

                    SetFromMouse(input.Position.X)

                end

            end)

            UserInputService.InputChanged:Connect(function(input)

                if Dragging and
                    input.UserInputType ==
                    Enum.UserInputType.MouseMovement then

                    SetFromMouse(input.Position.X)

                end

            end)

            UserInputService.InputEnded:Connect(function(input)

                if input.UserInputType ==
                    Enum.UserInputType.MouseButton1 then

                    Dragging = false

                end

            end)

            function SliderObject:Set(value)
                Set(value)
            end

            function SliderObject:Get()
                return Value
            end

            return SliderObject

        end

