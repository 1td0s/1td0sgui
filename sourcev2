                end

            end

            for _, option in ipairs(List) do

                local OptionButton = New("TextButton", {

                    Size = UDim2.new(1, 0, 0, 34),

                    BackgroundColor3 = Theme.PanelHover,

                    Text = tostring(option),

                    TextColor3 = Theme.Text,

                    TextSize = 13,

                    Font = Enum.Font.Gotham,

                    AutoButtonColor = false

                }, OptionHolder)

                OptionButton.MouseButton1Click:Connect(function()

                    Select(option)

                    Open = false

                    Holder.Size = UDim2.new(
                        1,
                        0,
                        0,
                        43
                    )

                end)

            end

            Button.MouseButton1Click:Connect(function()

                Open = not Open

                if Open then

                    Holder.Size = UDim2.new(
                        1,
                        0,
                        0,
                        43 + (#List * 34)
                    )

                else

                    Holder.Size = UDim2.new(
                        1,
                        0,
                        0,
                        43
                    )

                end

            end)

            function DropdownObject:Set(value)
                Select(value)
            end

            function DropdownObject:Get()
                return Selected
            end

            return DropdownObject

        end

        return Tab

    end

    --====================================================--
    --                   NOTIFICATIONS                    --
    --====================================================--

    local NotificationHolder = New("Frame", {

        Name = "Notifications",

        Size = UDim2.new(0, 300, 1, -90),

        Position = UDim2.new(
            1,
            -315,
            0,
            75
        ),

        BackgroundTransparency = 1,

        ZIndex = 200

    }, ScreenGui)

    New("UIListLayout", {

        Padding = UDim.new(0, 8),

        VerticalAlignment = Enum.VerticalAlignment.Bottom

    }, NotificationHolder)

    function window:Notify(options)

        options = options or {}

        local Duration = tonumber(options.Duration) or 3

        local Notification = New("Frame", {

            Size = UDim2.new(1, 0, 0, 72),

            BackgroundColor3 = Theme.Panel,

            BorderSizePixel = 0,

            ZIndex = 201

        }, NotificationHolder)

        Corner(Notification, 9)
        AddStroke(Notification, Theme.Stroke, 1)

        New("TextLabel", {

            Size = UDim2.new(1, -20, 0, 22),

            Position = UDim2.new(0, 10, 0, 8),

            BackgroundTransparency = 1,

            Text = options.Title or "1td0s",

            TextColor3 = Theme.Text,

            TextSize = 14,

            Font = Enum.Font.GothamSemibold,

            TextXAlignment = Enum.TextXAlignment.Left,

            ZIndex = 202

        }, Notification)

        New("TextLabel", {

            Size = UDim2.new(1, -20, 0, 32),

            Position = UDim2.new(0, 10, 0, 32),

            BackgroundTransparency = 1,

            Text = options.Content or "",

            TextColor3 = Theme.SubText,

            TextSize = 12,

            Font = Enum.Font.Gotham,

            TextWrapped = true,

            TextXAlignment = Enum.TextXAlignment.Left,

            ZIndex = 202

        }, Notification)

        task.delay(Duration, function()

            if Notification and Notification.Parent then
                Notification:Destroy()
            end

        end)

        return Notification

    end

    --====================================================--
    --                   SETTINGS TAB                    --
    --====================================================--

    local Settings = window:CreateTab({

        Name = "Settings",

        Icon = "⚙"

    })

    Settings:CreateSection("APPEARANCE")

    Settings:CreateLabel(
        "Change the background color of the menu."
    )

    local ColorHolder = New("Frame", {

        Size = UDim2.new(1, 0, 0, 130),

        BackgroundColor3 = Theme.Panel

    }, Settings.Page)

    Corner(ColorHolder, 8)

    local Preview = New("Frame", {

        Size = UDim2.new(0, 55, 0, 55),

        Position = UDim2.new(0, 15, 0, 15),

        BackgroundColor3 = Theme.Background

    }, ColorHolder)

    Corner(Preview, 8)

    AddStroke(Preview, Theme.Stroke, 1)

    local ColorBox = New("TextBox", {

        Size = UDim2.new(1, -90, 0, 40),

        Position = UDim2.new(0, 80, 0, 23),

        BackgroundColor3 = Theme.Background,

        Text = Color3ToHex(Theme.Background),

        PlaceholderText = "#RRGGBB",

        TextColor3 = Theme.Text,

        PlaceholderColor3 = Theme.Muted,

        TextSize = 14,

        Font = Enum.Font.Gotham,

        ClearTextOnFocus = false

    }, ColorHolder)

    Corner(ColorBox, 7)

    AddStroke(ColorBox, Theme.Stroke, 1)

    local ApplyColor = New("TextButton", {

        Size = UDim2.new(1, -30, 0, 35),

        Position = UDim2.new(0, 15, 0, 82),

        BackgroundColor3 = Theme.Accent,

        Text = "Apply Background Color",

        TextColor3 = Theme.White,

        TextSize = 13,

        Font = Enum.Font.GothamSemibold,

        AutoButtonColor = false

    }, ColorHolder)

    Corner(ApplyColor, 7)

    ApplyColor.MouseButton1Click:Connect(function()

        local NewColor = HexToColor3(ColorBox.Text)

        if not NewColor then

            window:Notify({

                Title = "1td0s",

                Content = "Invalid color. Use #RRGGBB.",

                Duration = 3

            })

            return

        end

        Theme.Background = NewColor

        Main.BackgroundColor3 = NewColor
        Preview.BackgroundColor3 = NewColor

        ColorBox.Text = Color3ToHex(NewColor)

        window:Notify({

            Title = "Settings",

            Content = "Background color updated.",

            Duration = 2

        })

    end)

    --====================================================--
    --                 SETTINGS: RESET                  --
    --====================================================--

    Settings:CreateSection("WINDOW")

    Settings:CreateButton({

        Name = "Reset Window Size",

        Callback = function()

            Main.Size = UDim2.new(
                0,
                760,
                0,
                500
            )

            window:Notify({

                Title = "Settings",

                Content = "Window size reset.",

                Duration = 2

            })

        end

    })

    Settings:CreateButton({

        Name = "Reset Background",

        Callback = function()

            Theme.Background =
                Color3.fromRGB(7, 11, 22)

            Main.BackgroundColor3 =
                Theme.Background

            Preview.BackgroundColor3 =
                Theme.Background

            ColorBox.Text =
                Color3ToHex(Theme.Background)

        end

    })

    --====================================================--
    --                   WINDOW METHODS                  --
    --====================================================--

    function window:Destroy()

        if ScreenGui then
            ScreenGui:Destroy()
        end

    end

    function window:Toggle()

        if ScreenGui.Enabled == true then
            ScreenGui.Enabled = false
        else
            ScreenGui.Enabled = true
        end

    end

    function window:SetBackgroundColor(color)

        if typeof(color) == "Color3" then

            Theme.Background = color
            Main.BackgroundColor3 = color
            Preview.BackgroundColor3 = color

        end

    end

    function window:GetBackgroundColor()

        return Theme.Background

    end

    return window

end

--========================================================--
--                     RETURN LIBRARY                     --
--========================================================--

return tdos
