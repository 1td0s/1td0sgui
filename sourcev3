        --================================================--

        function TabObject:CreateSlider(options)

            options = options or {}

            local Minimum = options.Min or 0
            local Maximum = options.Max or 100
            local Value = Clamp(
                options.Default or Minimum,
                Minimum,
                Maximum
            )

            local Holder = New(
                "Frame",
                {
                    Size = UDim2.new(1, 0, 0, 58),
                    BackgroundColor3 = Theme.Panel,
                    BorderSizePixel = 0
                },
                Page
            )

            Corner(Holder, 7)

            local Label = New(
                "TextLabel",
                {
                    Size = UDim2.new(1, -80, 0, 25),
                    Position = UDim2.fromOffset(14, 4),
                    BackgroundTransparency = 1,
                    Text = options.Name or "Slider",
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left
                },
                Holder
            )

            local ValueLabel = New(
                "TextLabel",
                {
                    Size = UDim2.fromOffset(60, 25),
                    Position = UDim2.new(1, -70, 0, 4),
                    BackgroundTransparency = 1,
                    Text = tostring(Value),
                    TextColor3 = Theme.Accent,
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Right
                },
                Holder
            )

            local Bar = New(
                "Frame",
                {
                    Size = UDim2.new(1, -28, 0, 6),
                    Position = UDim2.fromOffset(14, 39),
                    BackgroundColor3 = Theme.Background,
                    BorderSizePixel = 0
                },
                Holder
            )

            Corner(Bar, 5)

            local Fill = New(
                "Frame",
                {
                    Size = UDim2.new(
                        (Value - Minimum) / (Maximum - Minimum),
                        0,
                        1,
                        0
                    ),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0
                },
                Bar
            )

            Corner(Fill, 5)

            local Sliding = false

            local function UpdateFromMouse(mouseX)

                local Relative = Clamp(
                    mouseX - Bar.AbsolutePosition.X,
                    0,
                    Bar.AbsoluteSize.X
                )

                local Percent = Relative / Bar.AbsoluteSize.X

                Value = Minimum + ((Maximum - Minimum) * Percent)

                if options.Rounding then
                    Value = math.floor(Value / options.Rounding + 0.5) * options.Rounding
                else
                    Value = math.floor(Value + 0.5)
                end

                Value = Clamp(Value, Minimum, Maximum)

                ValueLabel.Text = tostring(Value)

                Tween(
                    Fill,
                    {
                        Size = UDim2.new(Percent, 0, 1, 0)
                    },
                    0.05
                )

                if options.Callback then
                    task.spawn(options.Callback, Value)
                end

            end

            Bar.InputBegan:Connect(function(input)

                if input.UserInputType == Enum.UserInputType.MouseButton1 then

                    Sliding = true
                    UpdateFromMouse(input.Position.X)

                end

            end)

            UserInputService.InputChanged:Connect(function(input)

                if Sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateFromMouse(input.Position.X)
                end

            end)

            UserInputService.InputEnded:Connect(function(input)

                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Sliding = false
                end

            end)

            local SliderObject = {}

            function SliderObject:Set(value)

                Value = Clamp(value, Minimum, Maximum)

                local Percent =
                    (Value - Minimum) /
                    (Maximum - Minimum)

                ValueLabel.Text = tostring(Value)

                Fill.Size = UDim2.new(
                    Percent,
                    0,
                    1,
                    0
                )

                if options.Callback then
                    task.spawn(options.Callback, Value)
                end

            end

            function SliderObject:Get()
                return Value
            end

            return SliderObject

        end

        --================================================--
        --                    DROPDOWN                    --
        --================================================--

        function TabObject:CreateDropdown(options)

            options = options or {}

            local Choices = options.Options or {}
            local Selected = options.Default or Choices[1]

            local Holder = New(
                "Frame",
                {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Theme.Panel,
                    BorderSizePixel = 0,
                    ClipsDescendants = true
                },
                Page
            )

            Corner(Holder, 7)

            local MainButton = New(
                "TextButton",
                {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false
                },
                Holder
            )

            local Label = New(
                "TextLabel",
                {
                    Size = UDim2.new(0.5, 0, 1, 0),
                    Position = UDim2.fromOffset(14, 0),
                    BackgroundTransparency = 1,
                    Text = options.Name or "Dropdown",
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left
                },
                MainButton
            )

            local SelectedLabel = New(
                "TextLabel",
                {
                    Size = UDim2.new(0.45, -20, 1, 0),
                    Position = UDim2.new(0.55, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(Selected or "..."),
                    TextColor3 = Theme.SubText,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Right
                },
                MainButton
            )

            local List = New(
                "Frame",
                {
                    Size = UDim2.new(1, -12, 0, math.min(#Choices * 30, 150)),
                    Position = UDim2.fromOffset(6, 42),
                    BackgroundTransparency = 1
                },
                Holder
            )

            local ListLayout = New(
                "UIListLayout",
                {
                    Padding = UDim.new(0, 3)
                },
                List
            )

            local Opened = false

            for _, Choice in ipairs(Choices) do

                local ChoiceButton = New(
                    "TextButton",
                    {
                        Size = UDim2.new(1, 0, 0, 27),
                        BackgroundColor3 = Theme.Background,
                        BorderSizePixel = 0,
                        Text = tostring(Choice),
                        TextColor3 = Theme.SubText,
                        TextSize = 11,
                        Font = Enum.Font.Gotham,
                        AutoButtonColor = false
                    },
                    List
                )

                Corner(ChoiceButton, 5)

                ChoiceButton.MouseButton1Click:Connect(function()

                    Selected = Choice
                    SelectedLabel.Text = tostring(Choice)

                    Opened = false

                    Holder.Size = UDim2.new(1, 0, 0, 42)

                    if options.Callback then
                        task.spawn(options.Callback, Choice)
                    end

                end)

            end

            MainButton.MouseButton1Click:Connect(function()

                Opened = not Opened

                if Opened then

                    Holder.Size = UDim2.new(
                        1,
                        0,
                        0,
                        48 + math.min(#Choices * 30, 150)
                    )

                else

                    Holder.Size = UDim2.new(
                        1,
                        0,
                        0,
                        42
                    )

                end

            end)

            return Holder

        end

        --================================================--
        --                  COLOR PICKER                  --
        --================================================--

        function TabObject:CreateColorPicker(options)

            options = options or {}

            local CurrentColor = options.Default or Theme.Accent

            local Holder = New(
                "Frame",
                {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Theme.Panel,
                    BorderSizePixel = 0
                },
                Page
            )

            Corner(Holder, 7)

            local Label = New(
                "TextLabel",
                {
                    Size = UDim2.new(1, -70, 1, 0),
                    Position = UDim2.fromOffset(14, 0),
                    BackgroundTransparency = 1,
                    Text = options.Name or "Color",
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left
                },
                Holder
            )

            local Preview = New(
                "TextButton",
                {
                    Size = UDim2.fromOffset(38, 24),
                    Position = UDim2.new(1, -50, 0.5, -12),
                    BackgroundColor3 = CurrentColor,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false
                },
                Holder
            )

            Corner(Preview, 6)
            Stroke(Preview, Theme.Stroke)

            local Popup

            Preview.MouseButton1Click:Connect(function()

                if Popup then
                    Popup:Destroy()
                    Popup = nil
                    return
                end

                Popup = New(
                    "Frame",
                    {
                        Size = UDim2.fromOffset(280, 105),
                        Position = UDim2.new(1, -285, 0, 45),
                        BackgroundColor3 = Theme.Panel,
                        BorderSizePixel = 0,
                        ZIndex = 50
                    },
                    Holder
                )

                Corner(Popup, 7)
                Stroke(Popup, Theme.Stroke)

                local Input = New(
                    "TextBox",
                    {
                        Size = UDim2.new(1, -20, 0, 38),
                        Position = UDim2.fromOffset(10, 10),
                        BackgroundColor3 = Theme.Background,
                        BorderSizePixel = 0,
                        Text = "#416DFF",
                        PlaceholderText = "#RRGGBB",
                        TextColor3 = Theme.Text,
                        PlaceholderColor3 = Theme.Muted,
                        TextSize = 13,
                        Font = Enum.Font.Gotham,
                        ClearTextOnFocus = false,
                        ZIndex = 51
                    },
                    Popup
                )

                Corner(Input, 6)
                Stroke(Input, Theme.Stroke)

                local Apply = New(
                    "TextButton",
                    {
                        Size = UDim2.new(1, -20, 0, 35),
                        Position = UDim2.fromOffset(10, 57),
                        BackgroundColor3 = Theme.Accent,
                        BorderSizePixel = 0,
                        Text = "Apply",
                        TextColor3 = Theme.White,
                        TextSize = 12,
                        Font = Enum.Font.GothamBold,
                        ZIndex = 51
                    },
                    Popup
                )

                Corner(Apply, 6)

                Apply.MouseButton1Click:Connect(function()

                    local Color = HexToColor(Input.Text)

                    if Color then

                        CurrentColor = Color
                        Preview.BackgroundColor3 = Color

                        if options.Callback then
                            task.spawn(options.Callback, Color)
                        end

                    end

                    Popup:Destroy()
                    Popup = nil

                end)

            end)

            return Holder

        end

        return TabObject

    end

    --====================================================--
    --                      SETTINGS                     --
    --====================================================--

    local SettingsTab = WindowObject:CreateTab({
        Name = "Settings",
        Icon = "⚙"
    })

    SettingsTab:CreateSection("APPEARANCE")

    SettingsTab:CreateColorPicker({
        Name = "Background Color",
        Default = Theme.Background,

        Callback = function(color)

            Theme.Background = color

            Window.BackgroundColor3 = color
            Content.BackgroundColor3 = color
            Header.BackgroundColor3 = color

        end
    })

    SettingsTab:CreateColorPicker({
        Name = "Accent Color",
        Default = Theme.Accent,

        Callback = function(color)

            Theme.Accent = color

        end
    })

    SettingsTab:CreateSection("WINDOW")

    SettingsTab:CreateButton({
        Name = "Reset Window Size",

        Callback = function()

            NormalSize = UDim2.fromOffset(760, 500)

            Window.Size = NormalSize

        end
    })

    SettingsTab:CreateButton({
        Name = "Reset Theme",

        Callback = function()

            Theme.Background = Color3.fromRGB(7, 11, 22)
            Theme.Accent = Color3.fromRGB(65, 145, 255)

            Window.BackgroundColor3 = Theme.Background
            Content.BackgroundColor3 = Theme.Background
            Header.BackgroundColor3 = Theme.Background

            WindowObject:Notify({
                Title = "1td0s",
                Content = "Theme reset.",
                Duration = 2
            })

        end
    })

    --====================================================--
    --                 PUBLIC WINDOW API                  --
    --====================================================--

    function WindowObject:GetWindow()
        return Window
    end

    function WindowObject:SetTitle(title)
        WindowName = tostring(title)
        BottomTitle.Text = WindowName
    end

    function WindowObject:SetSubtitle(subtitle)
        WindowSubtitle = tostring(subtitle)
    end

    function WindowObject:Destroy()

        Closed = true

        if ScreenGui then
            ScreenGui:Destroy()
        end

    end

    function WindowObject:Toggle()

        if Closed then
            return
        end

        MinimizeButton:Activate()

    end

    --====================================================--
    --                       RETURN                       --
    --====================================================--

    return WindowObject

end

return tdos
