        if Closed then
            return
        end

        Minimized = not Minimized

        if Minimized then

            NormalSize = Window.Size

            Sidebar.Visible = false
            Content.Visible = false
            ResizeHandle.Visible = false
            BottomTitle.Visible = false

            Tween(
                Window,
                {
                    Size = UDim2.fromOffset(
                        math.max(260, NormalSize.X.Offset),
                        48
                    )
                },
                0.2
            )

            MinimizeButton.Text = "+"

        else

            Tween(
                Window,
                {
                    Size = NormalSize
                },
                0.2
            )

            task.delay(0.2, function()

                if Closed then
                    return
                end

                Sidebar.Visible = true
                Content.Visible = true
                ResizeHandle.Visible = true
                BottomTitle.Visible = true

            end)

            MinimizeButton.Text = "−"

        end

    end)

    --====================================================--
    --                       CLOSE                        --
    --====================================================--

