            0.15
        )

        task.delay(0.15, function()

            if ScreenGui then
                ScreenGui:Destroy()
            end

        end)

    end)

    --====================================================--
    --                         FPS                        --
    --====================================================--

    local Frames = 0
    local LastFPSUpdate = tick()

    RunService.RenderStepped:Connect(function()

        if Closed then
            return
        end

        Frames += 1

        local Now = tick()

        if Now - LastFPSUpdate >= 1 then

            FPSLabel.Text = "FPS: " .. tostring(Frames)

            Frames = 0
            LastFPSUpdate = Now

        end

    end)

