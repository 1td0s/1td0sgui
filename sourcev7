        function tab:CreateToggle(text, default, callback)
            local state = default == true

            local holder = New("Frame", {
                Size = UDim2.new(1, -5, 0, 44),
                BackgroundColor3 = Theme.Panel,
                BorderSizePixel = 0
            }, tab.Page)

            Corner(holder, 8)

            New("TextLabel", {
