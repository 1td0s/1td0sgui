                Position = UDim2.fromOffset(14, 0),
                BackgroundTransparency = 1,
                Text = tostring(text),
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left
            }, holder)

            local toggle = New("TextButton", {
                Size = UDim2.fromOffset(47, 26),
                Position = UDim2.new(1, -59, 0.5, -13),
                BackgroundColor3 = Theme.Sidebar,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false
            }, holder)

            Corner(toggle, 13)
            AddStroke(toggle, Theme.Stroke, 1)

            local knob = New("Frame", {
                Size = UDim2.fromOffset(18, 18),
                Position = UDim2.fromOffset(4, 4),
                BackgroundColor3 = Theme.Muted,
                BorderSizePixel = 0
            }, toggle)

            Corner(knob, 9)

            local function Update()
                if state then
                    Tween(toggle, {BackgroundColor3 = Theme.Accent})
                    Tween(knob, {
                        Position = UDim2.new(1, -22, 0, 4),
                        BackgroundColor3 = Theme.White
                    })
                else
                    Tween(toggle, {BackgroundColor3 = Theme.Sidebar})
                    Tween(knob, {
                        Position = UDim2.fromOffset(4, 4),
                        BackgroundColor3 = Theme.Muted
                    })
                end
            end

            toggle.MouseButton1Click:Connect(function()
                state = not state
                Update()

                if callback then
                    task.spawn(callback, state)
                end
            end)

            Update()

            local api = {}

            function api:Set(value, fireCallback)
                state = value == true
                Update()

                if fireCallback ~= false and callback then
                    task.spawn(callback, state)
                end
            end

            function api:Get()
                return state
            end

            return api
        end

        function tab:CreateSlider(text, min, max, default, callback)
            min = min or 0
            max = max or 100
            if max == min then
                max = min + 1
            end

            local value = math.clamp(default or min, min, max)

            local holder = New("Frame", {
                Size = UDim2.new(1, -5, 0, 65),
                BackgroundColor3 = Theme.Panel,
                BorderSizePixel = 0
            }, tab.Page)

            Corner(holder, 8)

            New("TextLabel", {
                Size = UDim2.new(0.65, 0, 0, 25),
                Position = UDim2.fromOffset(14, 6),
                BackgroundTransparency = 1,
                Text = tostring(text),
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            }, holder)

            local valueLabel = New("TextLabel", {
                Size = UDim2.new(0.25, 0, 0, 25),
                Position = UDim2.new(0.72, 0, 0, 6),
                BackgroundTransparency = 1,
                Text = tostring(value),
                TextColor3 = Theme.Accent,
                Font = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right
            }, holder)

            local bar = New("TextButton", {
                Size = UDim2.new(1, -28, 0, 7),
                Position = UDim2.fromOffset(14, 43),
                BackgroundColor3 = Theme.Sidebar,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false
            }, holder)

            Corner(bar, 4)

            local fill = New("Frame", {
                Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0
            }, bar)

            Corner(fill, 4)

            local dragging = false

            local function SetValueFromX(x, fireCallback)
                local percent = math.clamp(
                    (x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
                    0,
                    1
                )

                value = min + (max - min) * percent

                if math.floor(value) == value then
                    value = math.floor(value)
                else
                    value = math.floor(value * 100) / 100
                end

                fill.Size = UDim2.new(percent, 0, 1, 0)
                valueLabel.Text = tostring(value)

                if fireCallback ~= false and callback then
                    task.spawn(callback, value)
                end
            end

            bar.MouseButton1Down:Connect(function()
                dragging = true
                SetValueFromX(UserInputService:GetMouseLocation().X)
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    SetValueFromX(input.Position.X)
                end
            end)

            local api = {}

            function api:Set(newValue, fireCallback)
                value = math.clamp(newValue, min, max)
                local percent = (value - min) / (max - min)

                fill.Size = UDim2.new(percent, 0, 1, 0)
                valueLabel.Text = tostring(value)

                if fireCallback ~= false and callback then
                    task.spawn(callback, value)
                end
            end

            function api:Get()
                return value
            end

            return api
        end

