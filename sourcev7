        local gradient = Instance.new("UIGradient")
        local keys = {}

        for i = 0, 12 do
            table.insert(keys, ColorSequenceKeypoint.new(
                i / 12,
                ColorFromHSV(i / 12, 1, 1)
            ))
        end

        gradient.Color = ColorSequence.new(keys)
        gradient.Parent = hueBar

        local hueButton = New("TextButton", {
            Size = UDim2.fromOffset(14, 14),
            Position = UDim2.new(0, -7, 0.5, -7),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false
        }, hueBar)

        Corner(hueButton, 7)
        AddStroke(hueButton, Theme.White, 1)

        local hueDragging = false
        local currentHue = select(1, Theme.Accent:ToHSV())

        local function SetHueFromX(x, fireCallback)
            local percent = math.clamp(
                (x - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1),
                0,
                1
            )

            currentHue = percent
            local color = ColorFromHSV(currentHue, 0.75, 1)

            SetAccent(color)

            hueButton.Position = UDim2.new(
                percent,
                -7,
                0.5,
                -7
            )

            if fireCallback then
                fireCallback(color)
            end
        end

        hueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                hueDragging = true
                SetHueFromX(UserInputService:GetMouseLocation().X)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                SetHueFromX(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                hueDragging = false
            end
        end)

        SetHueFromX(
            hueBar.AbsolutePosition.X +
            hueBar.AbsoluteSize.X * currentHue
        )

        return SettingsTab
    end

    --====================================================--
    -- WINDOW STATE
    --====================================================--

    local minimized = false

    --====================================================--
    -- MAIN API
    --====================================================--

    function windowApi:OpenSettings()
        BuildSettings()
        SelectTab(SettingsTab)
    end

    function windowApi:CloseSettings()
        if MainTab then
            SelectTab(MainTab)
        end
    end

    function windowApi:SetBackground(color)
        SetBackground(color)
    end

    function windowApi:SetAccent(color)
        SetAccent(color)
    end

    function windowApi:SetTitle(title)
        FooterTitle.Text = tostring(title)
    end

    function windowApi:GetUsername()
        return LocalPlayer.DisplayName
    end

    function windowApi:GetFPS()
        return tonumber(string.match(FPSLabel.Text, "%d+")) or 0
    end

    function windowApi:GetGui()
        return screenGui
    end

    function windowApi:Destroy()
        if screenGui then
            screenGui:Destroy()
        end
    end

    function windowApi:Minimize()
        if not minimized then
            MinimizeButton:Activate()
        end
    end

    function windowApi:Restore()
        if minimized then
            MinimizeButton:Activate()
        end
    end

    --====================================================--
    -- MAIN TAB IS CREATED FIRST
    --====================================================--

    MainTab = windowApi:CreateTab({
        Name = "Main",
        Icon = "◆"
    })

    --====================================================--
    -- SETTINGS BUTTON
    --====================================================--

    SettingsButton.MouseButton1Click:Connect(function()
        if not SettingsTab then
            BuildSettings()
        end

        SelectTab(SettingsTab)
    end)

    -- Clicking Main always leaves Settings.
    MainTab.Button.MouseButton1Click:Connect(function()
        SelectTab(MainTab)
    end)

    --====================================================--
    -- WINDOW DRAGGING
    --====================================================--

    local draggingWindow = false
    local dragStart
    local startPosition

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingWindow = true
            dragStart = input.Position
            startPosition = Window.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingWindow and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart

            Window.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingWindow = false
        end
    end)

    --====================================================--
    -- RESIZING
    --====================================================--

    local resizing = false
    local resizeStart
    local startSize
    local savedSize = Window.AbsoluteSize

    ResizeHandle.MouseButton1Down:Connect(function()
        if minimized then
            return
        end

        resizing = true
        resizeStart = UserInputService:GetMouseLocation()
        startSize = Window.AbsoluteSize
        savedSize = startSize
    end)

    UserInputService.InputChanged:Connect(function(input)
        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouse = UserInputService:GetMouseLocation()
            local delta = mouse - resizeStart

            local newWidth = math.max(560, startSize.X + delta.X)
            local newHeight = math.max(350, startSize.Y + delta.Y)

            Window.Size = UDim2.fromOffset(newWidth, newHeight)
            savedSize = Vector2.new(newWidth, newHeight)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = false
        end
    end)

    --====================================================--
    -- MINIMIZE / RESTORE
    --====================================================--

    MinimizeButton.MouseButton1Click:Connect(function()
        minimized = not minimized

        if minimized then
            savedSize = Window.AbsoluteSize

            Sidebar.Visible = false
            Content.Visible = false
            Footer.Visible = false
            ResizeHandle.Visible = false
            SettingsButton.Visible = false

            Window.Size = UDim2.fromOffset(savedSize.X, 62)
            MinimizeButton.Text = "+"
        else
            Window.Size = UDim2.fromOffset(
                math.max(560, savedSize.X),
                math.max(350, savedSize.Y)
            )

            Sidebar.Visible = true
            Content.Visible = true
            Footer.Visible = true
            ResizeHandle.Visible = true
            SettingsButton.Visible = true

            MinimizeButton.Text = "−"
        end
    end)

    --====================================================--
    -- CLOSE
    --====================================================--

    CloseButton.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    --====================================================--
    -- HOVER
    --====================================================--

    local function Hover(button)
        button.MouseEnter:Connect(function()
            button.TextColor3 = Theme.Text
        end)

        button.MouseLeave:Connect(function()
            button.TextColor3 = Theme.SubText
        end)
    end

    Hover(SettingsButton)
    Hover(MinimizeButton)
    Hover(CloseButton)

    --====================================================--
    -- FPS
    --====================================================--

    local frames = 0
    local lastTime = tick()

    RunService.RenderStepped:Connect(function()
        if not screenGui.Parent then
            return
        end

        frames += 1

        local now = tick()

        if now - lastTime >= 0.5 then
            local fps = math.floor(frames / (now - lastTime))

            FPSLabel.Text = tostring(fps) .. " FPS"

            frames = 0
            lastTime = now
        end
    end)

    --====================================================--
    -- FINAL
    --====================================================--

    windowApi.Window = Window
    windowApi.Main = MainTab

    -- Public convenience reference.
    tdos.Window = windowApi

    return windowApi
end

return tdos
