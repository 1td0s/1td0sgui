    local function SetBackground(color)
        Theme.Background = color
        Window.BackgroundColor3 = color
        TopBar.BackgroundColor3 = color
        Footer.BackgroundColor3 = color
    end

    local function SetAccent(color)
        Theme.Accent = color
        FPSLabel.TextColor3 = color

        for _, tab in ipairs(Tabs) do
            if tab.Page then
                tab.Page.ScrollBarImageColor3 = color
            end

            if tab.Page then
                for _, child in ipairs(tab.Page:GetChildren()) do
                    if child:IsA("TextLabel") and child.Text == string.upper(child.Text) then
                        child.TextColor3 = color
                    end
                end
            end
        end
    end

