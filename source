local function xs32(x)
    x = x % 4294967296
    x = bit32.bxor(x, (x * 4096) % 4294967296)
    x = bit32.bxor(x, math.floor(x / 131072))
    x = bit32.bxor(x, (x * 32) % 4294967296)
    return x % 4294967296
end

local function b64(s)
    local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local M = {}
    for i = 1, #A do
        M[A:sub(i,i)] = i - 1
    end

    local o = {}
    local n = 0

    for i = 1, #s, 4 do
        local a = M[s:sub(i,i)] or 0
        local b = M[s:sub(i+1,i+1)] or 0
        local cch = s:sub(i+2,i+2)
        local dch = s:sub(i+3,i+3)
        local c = M[cch] or 0
        local d = M[dch] or 0

        n = n + 1
        o[n] = string.char(a * 4 + math.floor(b / 16))

        if cch ~= "" and cch ~= "=" then
            n = n + 1
            o[n] = string.char((b % 16) * 16 + math.floor(c / 4))
        end

        if dch ~= "" and dch ~= "=" then
            n = n + 1
            o[n] = string.char((c % 4) * 64 + d)
        end
    end

    return table.concat(o)
end

local packed = table.concat(P):reverse()
local raw = b64(packed)

local seed = 2814615073
local out = {}

for i = 1, #raw do
    seed = xs32(seed)
    out[i] = string.char(bit32.bxor(raw:byte(i), seed % 256))
end

local fn, err = loadstring(table.concat(out))
if not fn then
    error(err)
end

return fn()
