local function bx(a,b)
    local r,p = 0,1
    while a > 0 or b > 0 do
        local aa = a % 2
        local bb = b % 2
        if aa ~= bb then r = r + p end
        a = (a-aa)/2
        b = (b-bb)/2
        p = p*2
    end
    return r
end

local function dec64(s)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i=1,#alphabet do map[alphabet:sub(i,i)] = i-1 end

    local out, n = {}, 0
    for i=1,#s,4 do
        local a = map[s:sub(i,i)] or 0
        local b = map[s:sub(i+1,i+1)] or 0
        local c = map[s:sub(i+2,i+2)] or 0
        local d = map[s:sub(i+3,i+3)] or 0

        n=n+1; out[n]=string.char(a*4+math.floor(b/16))
        if i+2 <= #s and s:sub(i+2,i+2) ~= "=" then
            n=n+1; out[n]=string.char((b%16)*16+math.floor(c/4))
        end
        if i+3 <= #s and s:sub(i+3,i+3) ~= "=" then
            n=n+1; out[n]=string.char((c%4)*64+d)
        end
    end
    return table.concat(out)
end

local encoded = S.data:reverse()
local raw = dec64(encoded)
local out, seed = {}, S.seed

for i=1,#raw do
    seed = (seed * 1103515245 + 12345) % 2147483648
    local k = math.floor(seed / 65536) % 256
    out[i] = string.char(bx(raw:byte(i), k))
end

local fn, err = loadstring(table.concat(out))
if not fn then error(err) end
return fn()
